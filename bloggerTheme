          return;
        }

        list.innerHTML = comments.map(function (c) {
          const depth = c.depth || (c.isReply ? 1 : 0);
          const depthAttr = depth ? ' style="--reply-depth:' + depth + ';"' : '';
          const avatarHtml = c.avatar
            ? '<img class="comment-avatar" src="' + escapeHtml(c.avatar) + '" alt="' + escapeHtml(c.author) + '" loading="lazy" decoding="async"/>'
            : '<div class="comment-avatar comment-avatar-empty" style="--avatar-bg:' + escapeHtml(c.avatarColor) + ';">' + escapeHtml(c.avatarText) + '</div>';
          const replyBtn = c.commentId ? '<button class="reply-btn" type="button" data-comment-reply="' + escapeHtml(c.commentId) + '">답글</button>' : '';
          const editBtn = (!c.isAnonymous && c.commentId) ? '<button class="comment-action-btn" type="button" data-comment-edit="' + escapeHtml(c.commentId) + '">수정</button>' : '';
          const deleteBtn = (!c.isAnonymous && c.commentId) ? '<button class="comment-action-btn" type="button" data-comment-delete="' + escapeHtml(c.commentId) + '">삭제</button>' : '';
          const anonNote = c.isAnonymous ? '<span class="comment-note">익명은 수정/삭제 불가</span>' : '';
          const actionHtml = (replyBtn || editBtn || deleteBtn || anonNote)
            ? '<div class="comment-actions">' + replyBtn + editBtn + deleteBtn + anonNote + '</div>'
            : '';
          return (
            '<div class="comment-item' + (depth ? ' reply' : '') + '"' + depthAttr + '>' +
              avatarHtml +
              '<div class="comment-content">' +
                '<div class="comment-meta">' +
                  '<span class="comment-author">' + escapeHtml(c.author) + '</span>' +
                  '<span class="comment-date">' + escapeHtml(formatTime(c.published)) + '</span>' +
                '</div>' +
                '<div class="comment-body">' + c.contentHtml + '</div>' +
                actionHtml +
              '</div>' +
            '</div>'
          );
        }).join('');
      }

      function orderComments(comments) {
        const byId = {};
        const children = {};
        const ordered = [];
        const seen = new Set();
        const sortByDate = (a, b) => (a.publishedTs || 0) - (b.publishedTs || 0);

        comments.forEach(c => {
          if (c && c.commentId) byId[c.commentId] = c;
        });

        comments.forEach(c => {
          const pid = c && c.parentId ? c.parentId : '';
          if (pid && byId[pid]) {
            if (!children[pid]) children[pid] = [];
            children[pid].push(c);
          }
        });

        const roots = comments.filter(c => !(c && c.parentId && byId[c.parentId]));
        roots.sort(sortByDate);
        Object.keys(children).forEach(id => children[id].sort(sortByDate));

        function addThread(node, depth) {
          node.depth = depth;
          ordered.push(node);
          seen.add(node);
          const kids = children[node.commentId] || [];
          for (let i = 0; i < kids.length; i++) addThread(kids[i], depth + 1);
        }

        for (let i = 0; i < roots.length; i++) addThread(roots[i], 0);

        if (ordered.length < comments.length) {
          comments.forEach(c => {
            if (!seen.has(c)) {
              c.depth = c.isReply ? 1 : 0;
              ordered.push(c);
            }
          });
        }

        return ordered;
      }

      async function setupCommentForm(post) {
