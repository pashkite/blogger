    .read-badge { position: absolute; top: 10px; right: 10px; padding: 4px 8px; border-radius: 999px; font-size: 11px; font-weight: 900; color: var(--accent-primary); background: rgba(108, 92, 231, 0.15); border: 1px solid rgba(108, 92, 231, 0.25); backdrop-filter: blur(10px); z-index: 2; }

    .content-list { display: flex; flex-direction: column; gap: 12px; }
