      }

      function buildCommentFrameCss() {
        const rootStyles = getComputedStyle(document.documentElement);
        const bg = rootStyles.getPropertyValue('--bg-body').trim() || '#ffffff';
        const surface = rootStyles.getPropertyValue('--bg-surface').trim() || '#f5f5f5';
        const text = rootStyles.getPropertyValue('--text-primary').trim() || '#111111';
        const textSecondary = rootStyles.getPropertyValue('--text-secondary').trim() || '#555555';
        const border = rootStyles.getPropertyValue('--border-subtle').trim() || 'rgba(0,0,0,0.08)';
        const accent = rootStyles.getPropertyValue('--accent-primary').trim() || '#5f27cd';
        const font = rootStyles.getPropertyValue('--font-sans').trim() || 'sans-serif';
        return (
          ':root{' +
            '--c-bg:' + bg + ';' +
            '--c-surface:' + surface + ';' +
            '--c-text:' + text + ';' +
            '--c-text-secondary:' + textSecondary + ';' +
            '--c-border:' + border + ';' +
            '--c-accent:' + accent + ';' +
            '--c-font:' + font + ';' +
          '}' +
          'html,body{background:var(--c-bg);color:var(--c-text);font-family:var(--c-font);}' +
          'a{color:var(--c-accent);}' +
          'input,textarea{width:100%;border:1px solid var(--c-border);border-radius:10px;padding:10px 12px;font-family:var(--c-font);font-size:14px;color:var(--c-text);background:var(--c-surface);}' +
          'button,input[type="submit"]{border-radius:999px;border:1px solid var(--c-border);background:var(--c-surface);padding:6px 12px;color:var(--c-text-secondary);font-weight:700;}' +
          'button:hover,input[type="submit"]:hover{border-color:var(--c-accent);color:var(--c-text);}' +
          '.comment-form{padding:12px;}'
        );
      }

      function applyCommentFrameStyles(frame) {
        if (!frame) return;
        try {
          const doc = frame.contentDocument;
          if (!doc || !doc.head) return;
          let styleEl = doc.getElementById('custom-comment-style');
          if (!styleEl) {
            styleEl = doc.createElement('style');
            styleEl.id = 'custom-comment-style';
            doc.head.appendChild(styleEl);
          }
          styleEl.textContent = buildCommentFrameCss();
        } catch (e) {
          // Cross-origin or blocked: silently skip.
        }
      }

      function bindCommentFrame(frame) {
        if (!frame || frame.dataset.bound === '1') return;
        frame.dataset.bound = '1';
        frame.addEventListener('load', function () { applyCommentFrameStyles(frame); });
      }

      function setCommentFormMode(mode, targetId) {
        STATE.commentFormMode = mode || 'new';
        STATE.commentFormTarget = targetId || '';
        const textEl = document.getElementById('commentFormModeText');
        const resetBtn = document.getElementById('commentFormReset');
        if (textEl) {
          if (STATE.commentFormMode === 'reply') textEl.textContent = '답글 작성';
          else if (STATE.commentFormMode === 'edit') textEl.textContent = '댓글 수정';
          else if (STATE.commentFormMode === 'delete') textEl.textContent = '댓글 삭제';
          else textEl.textContent = '일반 댓글';
        }
        if (resetBtn) resetBtn.classList.toggle('hidden', STATE.commentFormMode === 'new');
      }

      function resetCommentFormToBase({ scroll } = { scroll: false }) {
        const frame = document.getElementById('commentInlineFrame');
        const baseSrc = frame ? (frame.dataset.baseSrc || '') : '';
        if (frame && baseSrc && frame.getAttribute('src') !== baseSrc) frame.setAttribute('src', baseSrc);
        setCommentFormMode('new', '');
        if (scroll) {
          const container = document.getElementById('commentsContainer');
          if (container) container.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      function loadComments(post, { force } = { force: false }) {
        const list = document.getElementById('commentsList');
        const countEl = document.getElementById('commentCount');
        if (!list) return;
        list.setAttribute('aria-busy', 'true');
        list.innerHTML = '<div class="loading-spinner"></div>';
        if (countEl) countEl.textContent = '(...)';

        const postId = post && post.postId ? post.postId : post;
        if (!postId) {
          list.innerHTML = '<div class="empty-state"><p>댓글을 불러올 수 없습니다.</p></div>';
          list.setAttribute('aria-busy', 'false');
          if (countEl) countEl.textContent = '(0)';
          return;
        }

        const cacheKey = COMMENT_CACHE_PREFIX + String(postId);
        const cached = !force ? cacheGet(cacheKey, COMMENT_CACHE_TTL_MS) : null;
        if (cached && cached.entries) {
          const comments = orderComments(cached.entries.map(parseComment));
          renderComments(comments);
        } else {
          const url = '/feeds/' + encodeURIComponent(postId) + '/comments/default?alt=json';
          fetchJson(url).then(function (json) {
            const entries = (json && json.feed && json.feed.entry) ? json.feed.entry : [];
            cacheSet(cacheKey, { entries: entries });
            const comments = orderComments(entries.map(parseComment));
            renderComments(comments);
          }).catch(function () {
            list.innerHTML = '<div class="empty-state"><p>댓글을 불러오지 못했습니다.</p></div>';
            list.setAttribute('aria-busy', 'false');
            if (countEl) countEl.textContent = '(0)';
          });
        }

        setupCommentForm(post);
      }

      function toggleCommentForm({ open, scroll } = { open: true, scroll: true }) {
        const wrap = document.getElementById('commentIframeWrap');
        if (!wrap) return;
        const shouldOpen = (open === undefined) ? true : open;
        wrap.classList.toggle('hidden', !shouldOpen);
        if (scroll) {
          const container = document.getElementById('commentsContainer');
          if (container) container.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      async function openReplyForm(parentId) {
        if (!STATE.currentPost || !parentId) return;
        toggleCommentForm({ open: true, scroll: true });
        await setupCommentForm(STATE.currentPost);
        const frame = document.getElementById('commentInlineFrame');
        const baseSrc = frame ? (frame.dataset.baseSrc || frame.getAttribute('src') || '') : '';
        if (!baseSrc) return;
        if (!/^\d+$/.test(String(parentId))) {
          toast('이 댓글은 답글을 지원하지 않습니다.');
          return;
        }
        const replySrc = addUrlParam(baseSrc, 'parentID', parentId);
        if (frame && frame.getAttribute('src') !== replySrc) frame.setAttribute('src', replySrc);
        setCommentFormMode('reply', parentId);
      }

      async function openEditForm(commentId) {
        if (!STATE.currentPost || !commentId) return;
        toggleCommentForm({ open: true, scroll: true });
        await setupCommentForm(STATE.currentPost);
        const frame = document.getElementById('commentInlineFrame');
        const baseSrc = frame ? (frame.dataset.baseSrc || frame.getAttribute('src') || '') : '';
        if (!baseSrc) return;
        const editSrc = addUrlParam(baseSrc, 'commentID', commentId);
        if (frame && frame.getAttribute('src') !== editSrc) frame.setAttribute('src', editSrc);
        setCommentFormMode('edit', commentId);
      }

      async function openDeleteForm(commentId) {
        if (!STATE.currentPost || !commentId) return;
        toggleCommentForm({ open: true, scroll: true });
        await setupCommentForm(STATE.currentPost);
        const frame = document.getElementById('commentInlineFrame');
        const baseSrc = frame ? (frame.dataset.baseSrc || frame.getAttribute('src') || '') : '';
        if (!baseSrc) return;
        const deleteSrc = addUrlParam(addUrlParam(baseSrc, 'commentID', commentId), 'action', 'delete');
        if (frame && frame.getAttribute('src') !== deleteSrc) frame.setAttribute('src', deleteSrc);
        setCommentFormMode('delete', commentId);
      }

      function openCommentPopup({ scroll } = { scroll: true }) {
        // Backwards-compatible name: now opens inline comment form.
        toggleCommentForm({ open: true, scroll: scroll !== false });
        if (STATE.currentPost) {
          setupCommentForm(STATE.currentPost).then(function () {
            resetCommentFormToBase({ scroll: false });
          });
        } else {
          resetCommentFormToBase({ scroll: false });
        }
      }
      window.openCommentPopup = openCommentPopup;

      // ---------- Events ----------
      function bindEvents() {
        const tabLayers = document.getElementById('tabLayers');
        if(tabLayers) tabLayers.addEventListener('click', function (e) {
          const b = e.target.closest('.tab-btn'); if (!b) return;
          const layer = e.target.closest('.tabs');
          const level = parseInt(layer.dataset.level || '0', 10);

          const basePath = (STATE.hoverPath && STATE.hoverPath.length) ? STATE.hoverPath : STATE.selectedPath;
          STATE.selectedPath = basePath.slice(0, level);
          STATE.selectedPath.push(b.dataset.tab);
          autoSelectAllIfNeeded();
          STATE.listPath = STATE.selectedPath.slice();
          STATE.hoverPath = [];
          clearTimeout(STATE.hoverTimer);
          clearTimeout(STATE.hoverClearTimer);

          if (STATE.isReading) closePost({ skipPush: false });

          STATE.page = 1;
          updateView({ syncUrl: true });
        });
        if (tabLayers) tabLayers.addEventListener('mouseover', function (e) {
          if (!CAN_HOVER) return;
          const b = e.target.closest('.tab-btn'); if (!b) return;
          const layer = e.target.closest('.tabs');
          const level = parseInt(layer.dataset.level || '0', 10);
          const targetId = b.dataset.tab;
          STATE.hoverTargetId = targetId;
          STATE.hoverTargetLevel = level;
          clearTimeout(STATE.hoverTimer);
          clearTimeout(STATE.hoverClearTimer);
          const basePath = (STATE.hoverPath && STATE.hoverPath.length) ? STATE.hoverPath : STATE.selectedPath;
          const previewPath = basePath.slice(0, level);
          previewPath.push(targetId);
          if (isSamePath(STATE.hoverPath, previewPath) || isSamePath(STATE.selectedPath, previewPath)) return;
          STATE.hoverTimer = setTimeout(function () {
            if (STATE.hoverTargetId !== targetId || STATE.hoverTargetLevel !== level) return;
            const activeBase = (STATE.hoverPath && STATE.hoverPath.length) ? STATE.hoverPath : STATE.selectedPath;
            const hoverPath = activeBase.slice(0, level);
            hoverPath.push(targetId);
            if (isSamePath(STATE.hoverPath, hoverPath)) return;
            STATE.hoverPath = hoverPath;
            renderTabLayers();
          }, 60);
        });
        if (tabLayers) tabLayers.addEventListener('focusin', function (e) {
          const b = e.target.closest('.tab-btn'); if (!b) return;
          const layer = e.target.closest('.tabs');
          const level = parseInt(layer.dataset.level || '0', 10);
          const basePath = (STATE.hoverPath && STATE.hoverPath.length) ? STATE.hoverPath : STATE.selectedPath;
          const focusPath = basePath.slice(0, level);
          focusPath.push(b.dataset.tab);
          STATE.hoverPath = focusPath;
          renderTabLayers();
        });
        if (tabLayers) tabLayers.addEventListener('mouseleave', function () {
          if (!CAN_HOVER) return;
          if ((Date.now() - STATE.lastTabRenderAt) < 150) return;
          clearTimeout(STATE.hoverTimer);
          clearTimeout(STATE.hoverClearTimer);
          STATE.hoverClearTimer = setTimeout(function () {
            if (STATE.hoverPath && STATE.hoverPath.length) {
              STATE.hoverPath = [];
              renderTabLayers();
            }
          }, 80);
        });

        const viewToggle = document.querySelector('.view-toggle');
        if(viewToggle) viewToggle.addEventListener('click', function (e) {
          const b = e.target.closest('.view-btn'); if (!b) return;
          STATE.viewMode = b.dataset.view;
          updateView({ syncUrl: true });
        });

        const filterContainer = document.getElementById('filterContainer');
        if(filterContainer) filterContainer.addEventListener('click', function (e) {
          const b = e.target.closest('.filter-chip'); if (!b) return;
          STATE.filterMode = b.dataset.filter;
          STATE.page = 1;
          updateView({ syncUrl: true });
        });

        const sortSelect = document.getElementById('sortSelect');
        if(sortSelect) sortSelect.addEventListener('change', function (e) {
          STATE.sortMode = e.target.value;
          STATE.page = 1;
          updateView({ syncUrl: true });
        });

        const loadMoreBtn = document.getElementById('loadMoreBtn');
        if(loadMoreBtn) loadMoreBtn.addEventListener('click', async function () {
            // Simply increase page count to show more from memory
            STATE.page++;
            renderContent();
        });

        const searchInput = document.getElementById('searchInput');
        const searchClear = document.getElementById('searchClear');

        function syncSearchUI() {
          const v = searchInput.value || '';
          searchClear.classList.toggle('visible', v.length > 0);
        }
        searchInput.addEventListener('input', function () {
          syncSearchUI();
          debounce(function () {
            STATE.searchQuery = searchInput.value || '';
            STATE.page = 1;
            updateView({ syncUrl: true });
          }, 120);
        });
        searchClear.addEventListener('click', function () {
          searchInput.value = '';
          syncSearchUI();
          STATE.searchQuery = '';
          STATE.page = 1;
          updateView({ syncUrl: true });
          searchInput.focus();
        });

        const commentToggle = document.getElementById('commentFormToggle');
        if (commentToggle) commentToggle.addEventListener('click', function () {
          openCommentPopup({ scroll: false });
        });

        const commentRefresh = document.getElementById('commentRefreshBtn');
        if (commentRefresh) commentRefresh.addEventListener('click', function () {
          if (STATE.currentPost) loadComments(STATE.currentPost, { force: true });
        });

        const commentReset = document.getElementById('commentFormReset');
        if (commentReset) commentReset.addEventListener('click', function () {
          resetCommentFormToBase({ scroll: true });
        });

        document.getElementById('themeToggle').addEventListener('click', function () {
          CONFIG.theme = (CONFIG.theme === 'dark') ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', CONFIG.theme);
          try { localStorage.setItem(STORAGE_THEME, CONFIG.theme); } catch (e) {}
        });

        const infoModal = document.getElementById('infoModal');
        document.getElementById('infoBtn').addEventListener('click', function () { openOverlay(infoModal); });
        document.getElementById('infoCloseBtn').addEventListener('click', function () { closeOverlay(infoModal); });
        infoModal.addEventListener('click', function (e) { if (e.target && e.target.id === 'infoModal') closeOverlay(infoModal); });
        
        const shareModal = document.getElementById('shareOptionsModal');
        document.getElementById('shareCloseBtn').addEventListener('click', function () { closeOverlay(shareModal); });
        shareModal.addEventListener('click', function (e) { if (e.target && e.target.id === 'shareOptionsModal') closeOverlay(shareModal); });

        const backBtn = document.getElementById('backToListBtn');
        if(backBtn) backBtn.addEventListener('click', function () { closePost({ skipPush: false }); });

        document.addEventListener('click', function (e) {
          const tocLink = e.target.closest('.toc-item');
          if (tocLink) {
            const href = tocLink.getAttribute('href') || '';
            if (href.charAt(0) === '#') {
              const id = href.slice(1);
              const target = document.getElementById(id);
              if (target) {
                e.preventDefault();
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                try { history.replaceState(history.state || {}, '', location.pathname + location.search + '#' + id); } catch (err) {}
                return;
              }
            }
          }
          const openEl = e.target.closest('[data-open-post="1"]');
          if (openEl) {
            openPostById(openEl.getAttribute('data-post-id'), { skipPush: false });
            return;
          }

          const replyBtn = e.target.closest('[data-comment-reply]');
          if (replyBtn) {
            openReplyForm(replyBtn.getAttribute('data-comment-reply'));
            return;
          }
          
          const editBtn = e.target.closest('[data-comment-edit]');
          if (editBtn) {
            openEditForm(editBtn.getAttribute('data-comment-edit'));
            return;
          }

          const deleteBtn = e.target.closest('[data-comment-delete]');
          if (deleteBtn) {
            const targetId = deleteBtn.getAttribute('data-comment-delete');
            toast('댓글을 삭제할까요?', '삭제', function () { openDeleteForm(targetId); }, '취소');
            return;
          }

          const shareBtn = e.target.closest('.js-share');
          if (shareBtn) { openShareOptions(); return; }

          const codeCopy = e.target.closest('[data-code-copy="1"]');
          if (codeCopy) {
            const pre = codeCopy.closest('pre');
            const txt = pre ? pre.innerText : '';
            copyLink(txt);
            return;
          }

          const img = e.target.closest('#postContentContainer .post-content img');
          if (img) {
            const lb = document.getElementById('lightbox');
            document.getElementById('lightboxImg').src = img.src;
            openOverlay(lb);
            return;
          }
          
          if(e.target.closest('#mobileBackBtn')) closePost();
          if(e.target.closest('#mobileShareBtn')) openShareOptions();
          if(e.target.closest('#mobileCommentBtn')) openCommentPopup();
          if(e.target.closest('#mobileTopBtn')) window.scrollTo({top:0, behavior:'smooth'});
        });

        const btnTop = document.getElementById('scrollTop');
        window.addEventListener('scroll', function () {
          if (window.scrollY > 300) btnTop.classList.add('visible'); else btnTop.classList.remove('visible');
          if (STATE.isReading) updateReadingProgressBar();
        });
        btnTop.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });

        document.addEventListener('keydown', function (e) {
          trapTab(e);
          if ((e.key === 'Enter' || e.key === ' ') && e.target && e.target.closest && e.target.closest('[data-key-action="1"]')) {
            e.preventDefault();
            const el = e.target.closest('[data-key-action="1"]');
            if (el && typeof el.click === 'function') el.click();
            return;
          }
          if (e.key === '/' && !e.ctrlKey && !e.metaKey && !e.altKey) {
            const t = e.target;
            const tag = t && t.tagName ? t.tagName.toLowerCase() : '';
            if (tag !== 'input' && tag !== 'textarea' && !t.isContentEditable) {
              e.preventDefault();
              document.getElementById('searchInput').focus();
              return;
            }
          }
          if (e.key === 'Escape') {
            const closed = closeTopOverlay();
            if (closed) { e.preventDefault(); return; }
            if (STATE.isReading) { closePost({ skipPush: false }); e.preventDefault(); return; }
          }
        });

        window.addEventListener('popstate', function (ev) {
          const st = ev.state || {};
          if (st.view === 'post' && st.postId) {
            openPostById(st.postId, { skipPush: true });
            return;
          }

          if (STATE.isReading) setReadingMode(false);
          const q = parseListQuery();
          if (q.selectedPath) {
            STATE.selectedPath = q.selectedPath;
            STATE.listPath = q.selectedPath.slice();
          }
          if (typeof q.searchQuery === 'string') STATE.searchQuery = q.searchQuery;
          if (q.viewMode) STATE.viewMode = q.viewMode;
          if (q.filterMode) STATE.filterMode = q.filterMode;
          if (q.sortMode) STATE.sortMode = q.sortMode;
          if (q.page) STATE.page = q.page;

          const si = document.getElementById('searchInput');
          si.value = STATE.searchQuery || '';
          document.getElementById('searchClear').classList.toggle('visible', (si.value || '').length > 0);

          updateView({ syncUrl: false });
        });
      }

      // ---------- Init ----------
      async function init() {
        document.getElementById('year').textContent = String(new Date().getFullYear());

        loadReadMap();
        loadProgressMap();
        loadReaderPrefs();
        applyReaderPrefs();

        restorePrefs();

        const urlState = parseListQuery();
        if (urlState.selectedPath) {
          STATE.selectedPath = urlState.selectedPath;
          STATE.listPath = urlState.selectedPath.slice();
        }
        if (typeof urlState.searchQuery === 'string') STATE.searchQuery = urlState.searchQuery;
        if (urlState.viewMode) STATE.viewMode = urlState.viewMode;
        if (urlState.filterMode) STATE.filterMode = urlState.filterMode;
        if (urlState.sortMode) STATE.sortMode = urlState.sortMode;
        if (urlState.page) STATE.page = urlState.page;

        document.documentElement.setAttribute('data-theme', CONFIG.theme);
        try { localStorage.setItem(STORAGE_THEME, CONFIG.theme); } catch (e) {}

        const searchInput = document.getElementById('searchInput');
        searchInput.value = STATE.searchQuery || '';
        document.getElementById('searchClear').classList.toggle('visible', (searchInput.value || '').length > 0);

        const sortSelect = document.getElementById('sortSelect');
        if (sortSelect) sortSelect.value = STATE.sortMode;

        bindEvents();

        STATE.listUrl = location.href;

        // SINGLE FETCH LOGIC
        await loadAllPosts(false, isReloadNavigation());

        // item page direct open (also handle SPA post URL on reload)
        const pageType = document.body.getAttribute('data-page') || '';
        let pid = '';
        if (pageType === 'item') {
          pid = extractPostIdFromBloggerDom();
          if (!pid) pid = extractPostIdFromUrl();
        } else {
          pid = extractPostIdFromUrl();
        }
        if (pid) {
          try { history.replaceState({ view: 'post', postId: String(pid) }, '', location.href); } catch (e) {}
          await openPostById(pid, { skipPush: true });
        } else {
          if (pageType === 'item') console.warn('postId parse failed: fallback to list view');
          try { history.replaceState({ view: 'list' }, '', buildListUrlFromState()); } catch (e) {}
        }
      }

      window.addEventListener('DOMContentLoaded', init);
    })();
  //]]></script>
