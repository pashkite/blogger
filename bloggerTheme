        progressMap: {},
        readerPrefs: { fontSize: 17, width: 900 },
        lastFocusEl: null,
        modalStack: [],
        currentPostIdForComments: "",
        commentFormMode: "new",
        commentFormTarget: "",
        hoverPath: [],
        hoverTimer: null,
        hoverClearTimer: null,
        hoverTargetId: "",
        hoverTargetLevel: 0,
        tabsReady: false,
        lastTabRenderAt: 0,
        lastTabRenderKey: ""
      };

      // ---------- Utils ----------
      function escapeHtml(s) {
        return String(s || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'})[m]);
      }
      function isSafeUrl(url) {
        const u = String(url || '').trim().toLowerCase();
        if (!u) return false;
        if (u.indexOf('javascript:') === 0) return false;
        return /^(https?:|mailto:|\/|#|\?|\.\.\/|\.\/)/.test(u);
      }
      function formatInline(text) {
        let s = escapeHtml(text);
        const codeTokens = [];
        s = s.replace(/`([^`]+)`/g, function (_, code) {
          const token = '__CODE_TOKEN_' + codeTokens.length + '__';
          codeTokens.push('<code>' + code + '</code>');
          return token;
        });
        s = s.replace(/&lt;(https?:\/\/[^&]+)&gt;/g, function (_, url) {
          if (!isSafeUrl(url)) return '&lt;' + url + '&gt;';
          return '<a href="' + url + '">' + url + '</a>';
        });
        s = s.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, function (_, alt, url) {
          if (!isSafeUrl(url)) return '![' + alt + '](' + url + ')';
          return '<img src="' + url + '" alt="' + alt + '"/>';
        });
        s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, function (_, label, url) {
          if (!isSafeUrl(url)) return '[' + label + '](' + url + ')';
          return '<a href="' + url + '">' + label + '</a>';
        });
        s = s.replace(/~~([^~]+)~~/g, '<del>$1</del>');
        s = s.replace(/__([^_]+)__/g, '<strong>$1</strong>');
        s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        s = s.replace(/_([^_]+)_/g, '<em>$1</em>');
        s = s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
        s = s.split(/(<[^>]+>)/g).map(function (part) {
          if (part.indexOf('<') === 0) return part;
          return part.replace(/\bhttps?:\/\/[^\s<]+/g, function (url) {
            let clean = url;
            let trail = '';
            while (/[),.!?]$/.test(clean)) {
              trail = clean.slice(-1) + trail;
              clean = clean.slice(0, -1);
            }
            if (!isSafeUrl(clean)) return url;
            return '<a href="' + clean + '">' + clean + '</a>' + trail;
          });
        }).join('');
        codeTokens.forEach(function (html, idx) {
          s = s.replace('__CODE_TOKEN_' + idx + '__', html);
        });
        return s;
      }
      function markdownToHtml(md) {
        const lines = String(md || '').replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n');
        const out = [];
        let inCode = false;
        let codeLines = [];
        let codeFence = '';
        let codeLang = '';
        let listType = '';
        let listItems = [];
        let blockquoteLines = [];
        let paraLines = [];

        function flushParagraph() {
          if (!paraLines.length) return;
          out.push('<p>' + paraLines.map(formatInline).join('<br>') + '</p>');
          paraLines = [];
        }
        function formatListItem(text) {
          const m = String(text || '').match(/^\[( |x|X)\]\s+(.*)$/);
          if (!m) return formatInline(text);
          const checked = m[1].toLowerCase() === 'x';
          const label = m[2] || '';
          return '<label class="md-task"><input type="checkbox" disabled' + (checked ? ' checked' : '') + '/><span>' +
            formatInline(label) + '</span></label>';
        }
        function flushList() {
          if (!listItems.length) return;
          const items = listItems.map(i => '<li>' + formatListItem(i) + '</li>').join('');
          out.push('<' + listType + '>' + items + '</' + listType + '>');
          listItems = [];
          listType = '';
        }
        function flushBlockquote() {
          if (!blockquoteLines.length) return;
          out.push('<blockquote>' + blockquoteLines.map(formatInline).join('<br>') + '</blockquote>');
          blockquoteLines = [];
        }
        function flushCode() {
          const cls = codeLang ? ' class="language-' + escapeHtml(codeLang) + '"' : '';
          out.push('<pre><code' + cls + '>' + escapeHtml(codeLines.join('\n')) + '</code></pre>');
          codeLines = [];
          inCode = false;
          codeFence = '';
          codeLang = '';
        }
        function parseTableRow(line) {
          if (line.indexOf('|') < 0) return null;
          const cells = line.split('|');
          if (cells.length < 2) return null;
          if (cells[0].trim() === '') cells.shift();
          if (cells[cells.length - 1].trim() === '') cells.pop();
          return cells.map(c => c.trim());
        }
        function isTableSeparator(line) {
          return /^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)+\|?\s*$/.test(line);
        }
        function parseTableAlign(line) {
          const cells = parseTableRow(line);
          if (!cells || !cells.length) return [];
          return cells.map(function (c) {
            const t = c.trim();
            const left = t.indexOf(':') === 0;
            const right = t.lastIndexOf(':') === t.length - 1;
            if (left && right) return 'center';
            if (right) return 'right';
            return 'left';
          });
        }

        for (let i = 0; i < lines.length; i++) {
          const line = lines[i];
          const trimmed = line.trim();

          if (inCode) {
            if (codeFence && trimmed.indexOf(codeFence) === 0) {
              flushCode();
            } else {
              codeLines.push(line);
            }
            continue;
          }

          const fenceMatch = trimmed.match(/^(```|~~~)\s*([A-Za-z0-9_-]+)?/);
          if (fenceMatch) {
            flushParagraph();
            flushList();
            flushBlockquote();
            inCode = true;
            codeLines = [];
            codeFence = fenceMatch[1];
            codeLang = fenceMatch[2] || '';
            continue;
          }

          if (!trimmed) {
            flushParagraph();
            flushList();
            flushBlockquote();
            continue;
          }

          const next = (i + 1 < lines.length) ? lines[i + 1].trim() : '';
          if (next && (/^=+$/.test(next) || /^-+$/.test(next))) {
            flushParagraph();
            flushList();
            flushBlockquote();
            const level = /^=+$/.test(next) ? 1 : 2;
            out.push('<h' + level + '>' + formatInline(trimmed) + '</h' + level + '>');
            i += 1;
            continue;
          }

          const headerCells = parseTableRow(line);
          if (headerCells && next && isTableSeparator(next)) {
            flushParagraph();
            flushList();
            flushBlockquote();
            const aligns = parseTableAlign(next);
            const colCount = headerCells.length;
            const rows = [];
            let j = i + 2;
            for (; j < lines.length; j++) {
              const rowLine = lines[j];
              if (!rowLine.trim()) break;
              if (rowLine.indexOf('|') < 0) break;
              const rowCells = parseTableRow(rowLine);
              if (!rowCells) break;
              rows.push(rowCells);
            }
            const head = '<thead><tr>' + headerCells.map(function (c, idx) {
              const align = aligns[idx] || 'left';
              return '<th style="text-align:' + align + '">' + formatInline(c) + '</th>';
            }).join('') + '</tr></thead>';
            const body = rows.length ? '<tbody>' + rows.map(function (r) {
              return '<tr>' + headerCells.map(function (_, idx) {
                const align = aligns[idx] || 'left';
                const val = (idx < r.length) ? r[idx] : '';
                return '<td style="text-align:' + align + '">' + formatInline(val) + '</td>';
              }).join('') + '</tr>';
            }).join('') + '</tbody>' : '';
            out.push('<table class="md-table">' + head + body + '</table>');
            i = j - 1;
            continue;
          }

          if (/^(-{3,}|\*{3,}|_{3,})$/.test(trimmed)) {
            flushParagraph();
            flushList();
            flushBlockquote();
            out.push('<hr/>');
            continue;
          }

          const headingMatch = trimmed.match(/^(#{1,6})\s+(.*)$/);
          if (headingMatch) {
            flushParagraph();
            flushList();
            flushBlockquote();
            const level = headingMatch[1].length;
            out.push('<h' + level + '>' + formatInline(headingMatch[2]) + '</h' + level + '>');
            continue;
          }

          const bqMatch = trimmed.match(/^>\s?(.*)$/);
          if (bqMatch) {
            flushParagraph();
            flushList();
            blockquoteLines.push(bqMatch[1]);
            continue;
          } else {
            flushBlockquote();
          }

          const ulMatch = trimmed.match(/^[-*+]\s+(.*)$/);
          const olMatch = trimmed.match(/^\d+\.\s+(.*)$/);
          if (ulMatch || olMatch) {
            const nextType = olMatch ? 'ol' : 'ul';
            if (listType && listType !== nextType) flushList();
            listType = nextType;
            listItems.push(ulMatch ? ulMatch[1] : olMatch[1]);
            continue;
          } else {
            flushList();
          }

          paraLines.push(trimmed);
        }

        if (inCode) flushCode();
        flushParagraph();
        flushList();
        flushBlockquote();

        return out.join('');
      }
      function shouldRenderMarkdown(post) {
        if (!CONFIG.markdownMode || CONFIG.markdownMode === 'off') return false;
        if (CONFIG.markdownMode === 'all') return true;
        const labels = (post && post.labels) ? post.labels : [];
        const targets = Array.isArray(CONFIG.markdownLabels) ? CONFIG.markdownLabels : [];
        const lowerTargets = targets.map(t => String(t || '').toLowerCase());
        return labels.some(l => lowerTargets.includes(String(l || '').toLowerCase()));
      }
      function applyMarkdownIfNeeded(post) {
        if (!shouldRenderMarkdown(post)) return;
        const content = document.querySelector('#postContentContainer .post-content');
        if (!content) return;
        const raw = content.innerText || '';
        content.innerHTML = markdownToHtml(raw);
      }
      function sanitizeCommentHtml(html) {
        return String(html || '')
          .replace(/<script[\s\S]*?>[\s\S]*?<\/script>/gi, '')
          .replace(/<style[\s\S]*?>[\s\S]*?<\/style>/gi, '');
      }
      function safeJsonParse(s) { try { return JSON.parse(s); } catch (e) { return null; } }
      function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }
      function isMobileUA() { return /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent); }
      function getLabelParts(label) {
        return String(label || '')
          .split('-')
          .map(part => part.trim())
          .filter(Boolean);
      }
      function getPrimaryLabel(label) {
        const parts = getLabelParts(label);
        return parts.length ? parts[0] : '';
      }
      function isNoticeKeyword(part) {
        const p = String(part || '').toLowerCase();
        return p === '공지' || p === 'notice';
      }
      function getActivePathKey(path) {
        if (!Array.isArray(path) || !path.length) return 'all';
        let last = path[path.length - 1] || 'all';
        if (isAllId(last)) last = getAllParentId(last);
        if (!last || last === 'all') return 'all';
        return last;
      }
      function isNoticeLabel(label) {
        const parts = getLabelParts(label);
        return !!parts.length && isNoticeKeyword(parts[parts.length - 1]);
      }
      function getNoticeScopeId(label) {
        const parts = getLabelParts(label);
        if (!parts.length) return '';
        if (!isNoticeKeyword(parts[parts.length - 1])) return '';
        if (parts.length === 1) return '';
        return parts.slice(0, -1).join('-');
      }
      function isGlobalNotice(post) {
        const labels = (post && post.labels) ? post.labels : [];
        const hasNoticeLabel = labels.some(l => {
          const parts = getLabelParts(l);
          return parts.length && isNoticeKeyword(parts[0]);
        });
        if (hasNoticeLabel) return true;
        return /^\s*\[공지\]/.test(post && post.title ? post.title : '');
      }
      function isNoticeForPath(post, path) {
        const activeKey = getActivePathKey(path);
        if (!activeKey || activeKey === 'all') return isGlobalNotice(post);
        if (isNoticeKeyword(activeKey)) return isGlobalNotice(post);

        const labels = (post && post.labels) ? post.labels : [];
        for (let i = 0; i < labels.length; i++) {
          const scope = getNoticeScopeId(labels[i]);
          if (!scope) continue;
          if (activeKey === scope || activeKey.startsWith(scope + '-')) return true;
        }
        if (/^\s*\[공지\]/.test(post && post.title ? post.title : '')) {
          for (let i = 0; i < labels.length; i++) {
            if (isHiddenTabLabel(labels[i])) continue;
            if (isNoticeLabel(labels[i])) continue;
            const norm = normalizeLabelKey(labels[i]);
            if (!norm) continue;
            if (norm === activeKey || norm.startsWith(activeKey + '-') || activeKey.startsWith(norm + '-')) return true;
          }
        }
        return false;
      }
      function isHiddenTabLabel(label) {
        const hidden = Array.isArray(CONFIG.hiddenTabLabels) ? CONFIG.hiddenTabLabels : [];
        if (!hidden.length) return false;
        const primary = String(getPrimaryLabel(label || '')).toLowerCase();
        const norm = normalizeLabelKey(label).toLowerCase();
        for (let i = 0; i < hidden.length; i++) {
          const h = String(hidden[i] || '').toLowerCase();
          if (!h) continue;
          if (primary === h || norm === h) return true;
        }
        return false;
      }
      function getPrimaryVisibleLabel(labels) {
        const list = Array.isArray(labels) ? labels : [];
        for (let i = 0; i < list.length; i++) {
          if (!isHiddenTabLabel(list[i])) return list[i];
        }
        return '';
      }
      function normalizeLabelKey(label) {
        return getLabelParts(label).join('-');
      }
      function makeAllId(parentId) {
        return parentId + TAB_ALL_SUFFIX;
      }
      function isAllId(id) {
        return String(id || '').endsWith(TAB_ALL_SUFFIX);
      }
      function getAllParentId(id) {
        return String(id || '').slice(0, -TAB_ALL_SUFFIX.length);
      }
      function isLabelUnder(parentId, label) {
        const norm = normalizeLabelKey(label);
        return norm === parentId || norm.startsWith(parentId + '-');
      }
      function buildLabelHtml(label) {
        const parts = getLabelParts(label);
        if (!parts.length) return '';
        return parts.map((part, idx) => (
          '<span class="label-chip' + (idx > 0 ? ' sub' : '') + '">' + escapeHtml(part) + '</span>'
        )).join('<span class="label-sep">&gt;</span>');
      }
      function isSamePath(a, b) {
        if (!Array.isArray(a) || !Array.isArray(b)) return false;
        if (a.length !== b.length) return false;
        for (let i = 0; i < a.length; i++) {
          if (a[i] !== b[i]) return false;
        }
        return true;
      }

      function findTabNodeById(id, items) {
        const list = items || [];
        for (let i = 0; i < list.length; i++) {
          const node = list[i];
          if (node.id === id) return node;
          if (node.subTabs && node.subTabs.length) {
            const found = findTabNodeById(id, node.subTabs);
            if (found) return found;
          }
        }
        return null;
      }

      function hasDirectLabel(id) {
        return STATE.posts.some(p => (p.labels || []).some(l => normalizeLabelKey(l) === id));
      }
      function hashString(s) {
        let h = 0;
        const str = String(s || '');
        for (let i = 0; i < str.length; i++) {
          h = ((h << 5) - h) + str.charCodeAt(i);
          h |= 0;
        }
        return Math.abs(h);
      }
      function getAvatarColor(seed) {
        const colors = ['#ff7675', '#74b9ff', '#55efc4', '#ffeaa7', '#a29bfe', '#fd79a8', '#81ecec'];
        const idx = hashString(seed) % colors.length;
        return colors[idx];
      }
      function getAvatarText(name) {
        const trimmed = String(name || '').trim();
        if (!trimmed) return '?';
        const chars = Array.from(trimmed);
        return chars[0].toUpperCase();
      }

      function getUserLocale() {
        return (navigator.languages && navigator.languages[0]) ? navigator.languages[0] : (navigator.language || 'en');
      }
      function isReloadNavigation() {
        try {
          const nav = (performance.getEntriesByType && performance.getEntriesByType('navigation')) || [];
          if (nav && nav[0] && nav[0].type) return nav[0].type === 'reload';
          if (performance.navigation && typeof performance.navigation.type === 'number') return performance.navigation.type === 1;
        } catch (e) {}
        return false;
      }

      function formatDate(d) {
        const date = new Date(d);
        if (isNaN(date.getTime())) return '';
        try {
          return new Intl.DateTimeFormat(getUserLocale(), { month: 'numeric', day: 'numeric' }).format(date);
        } catch (e) {
          return (date.getMonth() + 1) + '.' + date.getDate();
        }
      }

      function formatTime(d) {
        const date = new Date(d);
        if (isNaN(date.getTime())) return '';
        try {
          return new Intl.DateTimeFormat(getUserLocale(), { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
        } catch (e) {
          return date.getFullYear() + '.' + (date.getMonth() + 1) + '.' + date.getDate();
        }
      }

      function formatPostMetaDate(d) {
        const date = new Date(d);
        if (isNaN(date.getTime())) return '';
        const locale = getUserLocale();
        if (String(locale).toLowerCase().startsWith('ko')) {
          const year = date.getFullYear();
          const month = String(date.getMonth() + 1).padStart(2, '0');
          const day = String(date.getDate()).padStart(2, '0');
          const weekday = new Intl.DateTimeFormat(locale, { weekday: 'short' }).format(date);
          return year + '년' + month + '월' + day + '일(' + weekday + ')';
        }
        try {
          return new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: '2-digit', weekday: 'short' }).format(date);
        } catch (e) {
          return date.toDateString();
        }
      }

      function setLoadingBar(percent) {
        const p = clamp(percent, 0, 100);
        const el = document.getElementById('loadingBar');
        if(el) el.style.width = p.toFixed(2) + '%';
      }

      function toast(msg, actionLabel, actionFn, cancelLabel, cancelFn) {
        const el = document.getElementById('toast');
        const text = document.getElementById('toastText');
        const action = document.getElementById('toastAction');
        const closeBtn = document.getElementById('toastClose');
        if (!el || !text || !action) return;

        text.textContent = msg || '';
        action.classList.remove('visible');
        if (closeBtn) closeBtn.classList.remove('visible');
        action.onclick = null;
        if (closeBtn) closeBtn.onclick = null;

        if (actionLabel && typeof actionFn === 'function') {
          action.textContent = actionLabel;
          action.classList.add('visible');
          action.onclick = function () {
            try { actionFn(); } catch (e) {}
            el.classList.remove('show');
          };
        }
        if (closeBtn && (actionLabel || cancelLabel)) {
          closeBtn.textContent = cancelLabel || '취소';
          closeBtn.classList.add('visible');
          closeBtn.onclick = function () {
            if (typeof cancelFn === 'function') {
              try { cancelFn(); } catch (e) {}
            }
            el.classList.remove('show');
          };
        }

        el.classList.add('show');
        clearTimeout(STATE.toastTimer);
        const ttl = (actionLabel || cancelLabel) ? 5000 : 1600;
        STATE.toastTimer = setTimeout(() => el.classList.remove('show'), ttl);
      }

      function fallbackCopyTextToClipboard(text) {
          var textArea = document.createElement("textarea");
          textArea.value = text;
          textArea.style.top = "0";
          textArea.style.left = "0";
          textArea.style.position = "fixed";
          textArea.style.opacity = "0";
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();
          try {
              var successful = document.execCommand('copy');
              var msg = successful ? '링크가 복사되었습니다.' : '복사 실패';
              toast(msg);
          } catch (err) {
              toast('복사 실패. 수동으로 복사해주세요.');
          }
          document.body.removeChild(textArea);
      }

      function copyLink(text) {
          const val = text || location.href;
          if (navigator.clipboard && navigator.clipboard.writeText) {
               navigator.clipboard.writeText(val).then(() => {
                   toast('링크가 복사되었습니다.');
               }).catch(() => {
                   fallbackCopyTextToClipboard(val);
               });
          } else {
              fallbackCopyTextToClipboard(val);
          }
      }

      // Share Modal Logic
      function openShareOptions() {
        const modal = document.getElementById('shareOptionsModal');
        if(modal) {
            openOverlay(modal);
            // Dynamic binding for modal buttons (context aware)
            const copyBtn = document.getElementById('shareCopyBtn');
            const twBtn = document.getElementById('shareTwitterBtn');
            const natBtn = document.getElementById('shareNativeBtn');
            const url = location.href;
            const title = document.title;
            
            if(copyBtn) copyBtn.onclick = () => { copyLink(url); closeTopOverlay(); };
            if(twBtn) twBtn.onclick = () => { window.open('https://twitter.com/intent/tweet?text='+encodeURIComponent(title)+'&url='+encodeURIComponent(url), '_blank'); closeTopOverlay(); };
            if(natBtn) natBtn.onclick = () => { 
                if(navigator.share) navigator.share({title, url}).catch(()=>{}); 
                else toast('이 브라우저에서는 지원하지 않습니다.');
                closeTopOverlay();
            };
            const closeBtn = document.getElementById('shareCloseBtn');
            if(closeBtn) closeBtn.onclick = () => closeTopOverlay();
        }
      }
      
      async function handleShare(btn) {
