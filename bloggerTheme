      }
      function applyReaderPrefs() {
        document.documentElement.style.setProperty('--reader-font-size', STATE.readerPrefs.fontSize + 'px');
        document.documentElement.style.setProperty('--reader-width', STATE.readerPrefs.width + 'px');
