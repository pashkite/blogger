      function savePrefs() {
        const payload = {
          selectedPath: STATE.listPath,
          viewMode: STATE.viewMode,
          filterMode: STATE.filterMode,
          sortMode: STATE.sortMode,
          searchQuery: STATE.searchQuery,
          page: STATE.page
