      function restorePrefs() {
        // theme
        const theme = localStorage.getItem(STORAGE_THEME);
        if (theme === 'dark' || theme === 'light') CONFIG.theme = theme;

        // list state
        const raw = localStorage.getItem(STORAGE_STATE);
        const p = safeJsonParse(raw);
        if (p && typeof p === 'object') {
          if (Array.isArray(p.selectedPath) && p.selectedPath.length) {
            STATE.selectedPath = p.selectedPath;
            STATE.listPath = p.selectedPath.slice();
          }
          if (p.viewMode === 'grid' || p.viewMode === 'list') STATE.viewMode = p.viewMode;
          if (p.filterMode === 'all' || p.filterMode === 'notice') STATE.filterMode = p.filterMode;
          if (p.sortMode === 'new' || p.sortMode === 'old' || p.sortMode === 'title' || p.sortMode === 'notice') STATE.sortMode = p.sortMode;
          if (typeof p.searchQuery === 'string') STATE.searchQuery = p.searchQuery;
          const pg = Number(p.page);
          if (!isNaN(pg) && pg >= 1) STATE.page = pg;
        }
      }

      // ---------- URL Routing ----------
      function parseListQuery() {
        const u = new URL(location.href);
        const path = u.searchParams.get('path');
        const q = u.searchParams.get('q') || '';
        const view = u.searchParams.get('view') || '';
        const filter = u.searchParams.get('filter') || '';
        const sort = u.searchParams.get('sort') || '';
        const page = u.searchParams.get('page') || '';

        const out = {};
        if (path) {
          const parts = path.split(',').map(s => decodeURIComponent(s.trim())).filter(Boolean);
          if (parts.length) out.selectedPath = parts;
        }
        if (typeof q === 'string') out.searchQuery = q;
        if (view === 'grid' || view === 'list') out.viewMode = view;
        if (filter === 'all' || filter === 'notice') out.filterMode = filter;
        if (sort === 'new' || sort === 'old' || sort === 'title' || sort === 'notice') out.sortMode = sort;

        const pg = Number(page);
        if (!isNaN(pg) && pg >= 1) out.page = pg;

        return out;
      }

      function buildListUrlFromState() {
        const base = getHomeUrl();
        const u = new URL(base, location.origin);

        // preserve pathname only (base may be absolute)
        const path = (STATE.listPath && STATE.listPath.length) ? STATE.listPath : STATE.selectedPath;
        u.searchParams.set('path', path.map(s => encodeURIComponent(s)).join(','));
        if (STATE.searchQuery) u.searchParams.set('q', STATE.searchQuery); else u.searchParams.delete('q');
        u.searchParams.set('view', STATE.viewMode);
        u.searchParams.set('filter', STATE.filterMode);
        u.searchParams.set('sort', STATE.sortMode);
        if (STATE.page > 1) u.searchParams.set('page', String(STATE.page)); else u.searchParams.delete('page');

        return u.pathname + (u.search ? u.search : '');
      }

      function syncUrlFromState({ replace } = { replace: true }) {
        if (STATE.isReading) return;
        const url = buildListUrlFromState();
        const st = { view: 'list' };
        try {
          if (replace) history.replaceState(st, '', url);
          else history.pushState(st, '', url);
        } catch (e) {}
      }

      // ---------- Tabs hierarchy ----------
      function buildHierarchy(labels) {
        const root = [];
        const normalized = labels.map(normalizeLabelKey).filter(Boolean);
        const sorted = Array.from(new Set(normalized)).sort((a, b) => String(a).localeCompare(String(b)));
        sorted.forEach(label => {
          const parts = getLabelParts(label);
          let current = root;
          parts.forEach((part, idx) => {
            const fullId = parts.slice(0, idx + 1).join('-');
            let node = current.find(n => n.id === fullId);
            if (!node) { node = { id: fullId, label: part, subTabs: [] }; current.push(node); }
            current = node.subTabs;
          });
        });
        return root;
      }

      function normalizeSelectedPath() {
        const path = [];
        let items = STATE.tabs;
        const saved = Array.isArray(STATE.selectedPath) ? STATE.selectedPath : ['all'];
        for (let i = 0; i < saved.length; i++) {
          const id = saved[i];
          if (isAllId(id)) {
            const parentId = getAllParentId(id);
            if (path[path.length - 1] !== parentId) {
              const parentFound = items.find(t => t.id === parentId);
              if (!parentFound) break;
              path.push(parentFound.id);
              items = parentFound.subTabs || [];
            }
            path.push(id);
            items = [];
            break;
          }
          const found = items.find(t => t.id === id);
          if (!found) break;
          path.push(found.id);
          items = found.subTabs || [];
          if (!items.length) break;
        }
        STATE.selectedPath = path.length ? path : ['all'];
        autoSelectAllIfNeeded();
        STATE.listPath = STATE.selectedPath.slice();
      }

      // ---------- Feed fetch + cache ----------
      async function fetchJson(url) {
        try {
          const res = await fetch(url, { credentials: 'same-origin' });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          const text = await res.text();
          try {
            return JSON.parse(text);
          } catch (e) {
            // response was text/html (likely 404 or auth page) starting with <
            console.warn('Feed response was not JSON:', text.substring(0, 50));
            throw new Error('Not JSON'); 
          }
        } catch (err) {
          throw err;
        }
      }

      function cacheGet(key, ttlMs) {
        try {
          const raw = sessionStorage.getItem(key);
          const obj = safeJsonParse(raw);
          if (!obj || !obj.t || !obj.v) return null;
          const ttl = (typeof ttlMs === 'number') ? ttlMs : CACHE_TTL_MS;
          if ((Date.now() - obj.t) > ttl) return null;
          return obj.v;
        } catch (e) { return null; }
      }
      function cacheSet(key, value) {
        try { sessionStorage.setItem(key, JSON.stringify({ t: Date.now(), v: value })); } catch (e) {}
      }

      function extractFirstImage(html) {
        if (!html) return '';
        const m = String(html).match(/<img[^>]+src=["']([^"']+)["']/i);
        return m ? m[1] : '';
      }
      function upgradeThumb(url, size) {
        if (!url) return '';
        const s = size || 480;
        let u = url.replace(/\/s\d+\-c\//, '/s' + s + '-c/').replace(/=s\d+\-c/, '=s' + s + '-c');
        if (u.includes('youtube.com') && u.includes('default.jpg')) {
            u = u.replace('default.jpg', 'mqdefault.jpg');
        }
        return u;
      }

      function parseEntry(entry) {
        const rawId = entry && entry.id && entry.id.$t ? entry.id.$t : '';
        const idMatch = rawId.match(/post-(\d+)$/);
        const postId = idMatch ? idMatch[1] : rawId;

        const title = entry && entry.title ? entry.title.$t : '';
        const author = entry && entry.author && entry.author[0] ? entry.author[0].name.$t : '';
        const published = entry && entry.published ? entry.published.$t : '';
        const labels = entry && entry.category ? entry.category.map(c => c.term) : [];
        const urlObj = (entry && entry.link ? entry.link.find(l => l.rel === 'alternate' && l.type === 'text/html') : null);
        const url = urlObj ? urlObj.href : '';
        const contentHtml = entry && entry.content ? entry.content.$t : (entry && entry.summary ? entry.summary.$t : '');
        const commentCount = entry && entry['thr$total'] && entry['thr$total'].$t ? entry['thr$total'].$t : '';

        const thumb = entry && entry.media$thumbnail ? entry.media$thumbnail.url : extractFirstImage(contentHtml);
        const isNotice = labels.some(l => {
          const parts = getLabelParts(l);
          const head = parts.length ? parts[0] : '';
          return head === 'Notice' || head === '공지';
        }) || /^\s*\[공지\]/.test(title);

        // New Badge (within 3 days)
        const isNew = (Date.now() - new Date(published).getTime()) < (3 * 24 * 60 * 60 * 1000);

        return {
          postId,
          title,
          author,
          published,
          labels,
          url,
          contentHtml,
          thumbnail: upgradeThumb(thumb, 640),
          commentCount,
          isNotice,
          isNew
        };
      }

      // Single Fetch Logic: load 500 items once
      async function loadAllPosts(replace = false, force = false) {
        if (STATE.loading) return;
        STATE.loading = true;

        const url = CONFIG.feedBase + '?alt=json' + '&max-results=500';
        const cacheKey = CACHE_PREFIX + 'all';

        if (force) {
          try { sessionStorage.removeItem(cacheKey); } catch (e) {}
        }
        const cached = force ? null : cacheGet(cacheKey);
        if (cached && cached.feed) {
             processFeed(cached, replace);
             STATE.loading = false;
             return;
        }

        try {
            const json = await fetchJson(url);
            cacheSet(cacheKey, json);
            processFeed(json, replace);
        } catch(e) {
             showError('피드를 불러오지 못했습니다.', () => loadAllPosts(replace));
        } finally {
            STATE.loading = false;
        }
      }

      function processFeed(json, replace) {
          const entries = json.feed.entry || [];
          const parsed = entries.map(parseEntry);
          
          if(replace) STATE.posts = [];
          STATE.posts = parsed; // Store all 500 items in memory

          // Generate Tabs
          const allLabels = [];
          STATE.posts.forEach(p => (p.labels || []).forEach(l => {
            if (isNoticeLabel(l) && getLabelParts(l).length > 1) return;
            if (!isHiddenTabLabel(l)) allLabels.push(l);
          }));
          STATE.tabs = [{ id: 'all', label: '전체', subTabs: [] }].concat(buildHierarchy(allLabels));
          normalizeSelectedPath();

          updateView();
      }

      async function fetchSinglePost(postId) {
        const cacheKey = POST_CACHE_PREFIX + postId;
        const cached = cacheGet(cacheKey);
        if (cached && cached.entry) {
          try { return parseEntry(cached.entry); } catch (e) {}
        }
        // Fetch full content from /feeds/posts/default/postId
        const url = '/feeds/posts/default/' + postId + '?alt=json';
        const json = await fetchJson(url);
        if (json && json.entry) cacheSet(cacheKey, json);
        const entry = json && json.entry ? json.entry : null;
        if (!entry) throw new Error('No entry');
        return parseEntry(entry);
      }

      // ---------- UI Render ----------
      function showError(msg, retryFn) {
        const c = document.getElementById('contentArea');
        if(!c) return;
        c.className = 'content-grid';
        c.innerHTML =
          '<div class="error-msg">' +
            '<div>' + escapeHtml(msg) + '</div>' +
            '<div class="error-actions">' +
              '<button class="btn-retry" id="retryBtn" type="button">재시도</button>' +
            '</div>' +
          '</div>';
        setTimeout(function () {
          const b = document.getElementById('retryBtn');
          if (b && typeof retryFn === 'function') b.onclick = retryFn;
        }, 0);
      }

      function renderTabLayers() {
        const host = document.getElementById('tabLayers');
        if(!host) return;
        const activePath = (STATE.listPath && STATE.listPath.length) ? STATE.listPath : (Array.isArray(STATE.selectedPath) ? STATE.selectedPath : []);
        const renderPath = (STATE.hoverPath && STATE.hoverPath.length) ? STATE.hoverPath : activePath;
        const pathKey = 'r:' + (Array.isArray(renderPath) ? renderPath.join('|') : '') +
          '|a:' + (Array.isArray(activePath) ? activePath.join('|') : '');
        if (STATE.lastTabRenderKey === pathKey && host.childNodes.length) return;

        const frag = document.createDocumentFragment();
        renderLayer(frag, 0, STATE.tabs, null, activePath, renderPath);

        let currentItems = STATE.tabs;
        for (let level = 0; level < renderPath.length; level++) {
          const renderId = renderPath[level];
          const found = currentItems.find(t => t.id === renderId);
          if (found && found.subTabs && found.subTabs.length > 0) {
            renderLayer(frag, level + 1, found.subTabs, found.id, activePath, renderPath);
            currentItems = found.subTabs;
          } else {
            break;
          }
        }

        host.replaceChildren(frag);
        STATE.lastTabRenderKey = pathKey;
        STATE.lastTabRenderAt = Date.now();
        if (!STATE.tabsReady) {
          document.body.classList.add('tabs-ready');
          STATE.tabsReady = true;
        }
      }

      function renderLayer(host, level, items, parentId, activePath, renderPath) {
        const nav = document.createElement('div');
        nav.className = 'tabs layer';
        nav.dataset.level = String(level);
        nav.setAttribute('role', 'tablist');

        const activeId = (activePath && activePath[level]) ? activePath[level] : (level === 0 ? 'all' : '');
        const list = (parentId && items.length)
          ? [{ id: makeAllId(parentId), label: '전체보기', isAll: true }].concat(items)
          : items;

        nav.innerHTML = list.map(t => (
          '<button class="tab-btn ' + (t.isAll ? 'all ' : '') + (activeId === t.id ? 'active' : '') + '"' +
            ' data-tab="' + escapeHtml(t.id) + '"' +
            ' role="tab"' +
            ' aria-selected="' + (activeId === t.id ? 'true' : 'false') + '"' +
            ' aria-label="' + escapeHtml(t.label) + '"' +
          '>' + escapeHtml(t.label) + '</button>'
        )).join('');
        host.appendChild(nav);
      }

      function autoSelectAllIfNeeded() {
        const currentId = STATE.selectedPath[STATE.selectedPath.length - 1] || 'all';
        if (currentId === 'all' || isAllId(currentId)) return;
        const node = findTabNodeById(currentId, STATE.tabs);
        if (!node || !node.subTabs || !node.subTabs.length) return;
        if (hasDirectLabel(currentId)) return;
        STATE.selectedPath.push(makeAllId(currentId));
      }


      function highlightQuery(text, query) {
        const t = String(text || '');
        const q = String(query || '').trim();
        if (!q) return escapeHtml(t);
        const idx = t.toLowerCase().indexOf(q.toLowerCase());
        if (idx < 0) return escapeHtml(t);
        const a = t.slice(0, idx);
        const b = t.slice(idx, idx + q.length);
        const c = t.slice(idx + q.length);
        return escapeHtml(a) + '<span class="title-hl">' + escapeHtml(b) + '</span>' + escapeHtml(c);
      }

      function getFilteredData() {
        const activePath = (STATE.listPath && STATE.listPath.length) ? STATE.listPath : STATE.selectedPath;
        const currentId = activePath[activePath.length - 1] || 'all';
        let d = STATE.posts.slice(); // Filter from ALL posts in memory

        if (currentId !== 'all') {
          if (isAllId(currentId)) {
            const parentId = getAllParentId(currentId);
            d = d.filter(item => (item.labels || []).some(cat => isLabelUnder(parentId, cat)));
          } else {
            d = d.filter(item => (item.labels || []).some(cat => normalizeLabelKey(cat) === currentId));
          }
        }
        const isNoticeActive = function (post) { return isNoticeForPath(post, activePath); };
        if (STATE.filterMode === 'notice') d = d.filter(isNoticeActive);
        if (STATE.searchQuery) d = d.filter(i => (i.title || '').toLowerCase().includes(STATE.searchQuery.toLowerCase()));

        // sort
        if (STATE.sortMode === 'new') d.sort((a, b) => new Date(b.published) - new Date(a.published));
        else if (STATE.sortMode === 'old') d.sort((a, b) => new Date(a.published) - new Date(b.published));
        else if (STATE.sortMode === 'title') d.sort((a, b) => String(a.title).localeCompare(String(b.title)));
        else if (STATE.sortMode === 'notice') d.sort((a, b) => {
          const an = isNoticeActive(a);
          const bn = isNoticeActive(b);
          return (bn === an) ? (new Date(b.published) - new Date(a.published)) : (bn ? 1 : -1);
        });

        return d;
      }

      function renderNotices() {
        const c = document.getElementById('noticeArea');
        if(!c) return;
        const activePath = (STATE.listPath && STATE.listPath.length) ? STATE.listPath : STATE.selectedPath;
        const n = STATE.posts.filter(i => isNoticeForPath(i, activePath)).slice(0, 3);
        if (!n.length || STATE.filterMode === 'notice' || STATE.isReading) { c.classList.add('hidden'); return; }
        c.classList.remove('hidden');
        c.innerHTML = n.map(i => (
          '<div class="notice-card fade-in" role="button" tabindex="0" data-open-post="1" data-post-id="' + escapeHtml(i.postId) + '" aria-label="Open notice">' +
            '<div class="flex items-center" style="overflow:hidden; gap:8px;">' +
              '<span class="notice-badge">공지</span>' +
              '<span class="notice-title">' + escapeHtml(i.title) + '</span>' +
            '</div>' +
            '<div style="font-size:12px; color:var(--text-tertiary); min-width:60px; text-align:right;">' + formatDate(i.published) + '</div>' +
          '</div>'
        )).join('');
      }

      function renderContent() {
        const c = document.getElementById('contentArea');
        if(!c) return;
        
        const f = getFilteredData();
        const slice = f.slice(0, STATE.page * CONFIG.pageSize);
        const hasMore = f.length > slice.length;

        const btn = document.getElementById('loadMoreBtn');
        if(btn) btn.style.display = hasMore ? 'block' : 'none';

        if (!slice.length) {
          c.className = 'content-grid';
          c.innerHTML = '<div class="empty-state"><p>' + (STATE.posts.length === 0 ? '' : 'No posts found.') + '</p></div>';
          return;
        }

        c.className = (STATE.viewMode === 'grid') ? 'content-grid' : 'content-list';

        c.innerHTML = slice.map((i, idx) => {
          const delay = (idx % CONFIG.pageSize) * 0.03;
          const tag = getPrimaryVisibleLabel(i.labels) || 'BLOG';
          const thumb = i.thumbnail || '';
          const isRead = !!STATE.readMap[String(i.postId)];
          const labelHtml = buildLabelHtml(tag);
          const thumbTag = getPrimaryLabel(tag);
          const hasThumb = !!thumb;
          const commentCountNum = parseInt(i.commentCount, 10);
          const commentHtml = commentCountNum > 0 ? '<span class="list-comments">댓글 ' + commentCountNum + '</span>' : '';
          const thumbHtml = hasThumb
            ? '<img src="' + escapeHtml(thumb) + '" class="card-thumb" loading="lazy" alt="' + escapeHtml(i.title || 'Post thumbnail') + '" decoding="async" onload="this.classList.add(\'loaded\')"/>'
            : '<div class="card-thumb empty">' + (thumbTag ? '<span class="thumb-tag">' + escapeHtml(thumbTag) + '</span>' : '<span class="thumb-tag">POST</span>') + '</div>';

          if (STATE.viewMode === 'list') {
            return (
              '<article class="list-row" role="button" tabindex="0"' +
                ' data-open-post="1" data-post-id="' + escapeHtml(i.postId) + '"' +
                ' aria-label="Open post ' + escapeHtml(i.title) + '">' +
                '<div class="list-left">' +
                  (thumbTag ? '<span class="list-label">' + escapeHtml(thumbTag) + '</span>' : '') +
                  '<div class="list-title">' + highlightQuery(i.title, STATE.searchQuery) + '</div>' +
                  commentHtml +
                  (isRead ? '<span class="list-read">READ</span>' : '') +
                '</div>' +
                '<div class="list-right">' +
                  '<span class="list-author">' + escapeHtml(i.author) + '</span>' +
                  '<span class="list-date">' + formatDate(i.published) + '</span>' +
                '</div>' +
              '</article>'
            );
          }
          return (
            '<article class="card fade-in' + (hasThumb ? '' : ' no-thumb') + '" style="animation-delay:' + delay + 's" role="button" tabindex="0"' +
              ' data-open-post="1" data-post-id="' + escapeHtml(i.postId) + '"' +
              ' aria-label="Open post ' + escapeHtml(i.title) + '">' +
              (i.isNew ? '<div class="new-badge">N</div>' : '') +
              (isRead ? '<div class="read-badge">READ</div>' : '') +
              thumbHtml +
              '<div class="card-body">' +
                '<div class="card-meta-top">' + (labelHtml ? '<div class="label-stack">' + labelHtml + '</div>' : '') + '</div>' +
                '<h3 class="card-title">' + highlightQuery(i.title, STATE.searchQuery) + '</h3>' +
                '<div class="card-footer"><span>' + escapeHtml(i.author) + '</span><span>' + formatDate(i.published) + '</span></div>' +
              '</div>' +
            '</article>'
          );
        }).join('');
      }

      function updateView({ syncUrl } = { syncUrl: true }) {
        if(STATE.isReading) return;
        STATE.hoverPath = [];
        renderTabLayers();
        renderNotices();
        renderContent();

        document.querySelectorAll('.view-btn').forEach(b => b.classList.toggle('active', b.dataset.view === STATE.viewMode));
        document.querySelectorAll('.filter-chip').forEach(b => b.classList.toggle('active', b.dataset.filter === STATE.filterMode));
        const sortSelect = document.getElementById('sortSelect');
        if (sortSelect) sortSelect.value = STATE.sortMode;

        savePrefs();
        if (syncUrl) syncUrlFromState({ replace: true });
      }

      // ---------- Reading mode switching ----------
      function setReadingMode(isReading) {
        STATE.isReading = !!isReading;
        document.body.classList.toggle('is-reading', STATE.isReading);

        const list = document.getElementById('listViewArea');
        const single = document.getElementById('singlePostView');

        if (STATE.isReading) {
          if(list) list.style.display = 'none';
          if(single) {
              single.style.display = 'block';
              single.classList.remove('hidden');
          }
        } else {
          if(single) single.style.display = 'none';
          if(list) list.style.display = 'block';
        }
      }

      function updateReadingProgressBar() {
        if (!STATE.isReading) return;
        const container = document.querySelector('#postContentContainer .post-content');
        if (!container) return;

        const rect = container.getBoundingClientRect();
        const top = window.scrollY + rect.top;
        const height = container.scrollHeight;
        const viewport = window.innerHeight;

        const current = window.scrollY - top;
        const denom = Math.max(1, height - viewport);
        const ratio = current / denom;
        setLoadingBar(ratio * 100);

        // save progress (throttle-ish)
        if (STATE.currentPost && STATE.currentPost.postId) {
          const pid = String(STATE.currentPost.postId);
          const prev = STATE.progressMap[pid];
          const now = window.scrollY || 0;
          if (!prev || Math.abs(prev - now) > 200) {
            STATE.progressMap[pid] = now;
            saveProgressMap();
          }
        }
      }

      function slugify(text) {
        return String(text || '')
          .trim()
          .toLowerCase()
          .replace(/[\s]+/g, '-')
          .replace(/[^\w\-가-힣]/g, '')
          .slice(0, 60);
      }

      function cleanupTOC() {
        if (STATE.tocObserver) {
          try { STATE.tocObserver.disconnect(); } catch (e) {}
          STATE.tocObserver = null;
        }
        STATE.tocItems = [];
      }

      function buildTOC() {
        cleanupTOC();

        const root = document.querySelector('#postContentContainer .post-card');
        const content = document.querySelector('#postContentContainer .post-content');
        if (!root || !content) return;

        const headings = Array.from(content.querySelectorAll('h2, h3')).slice(0, 24);
        if (!headings.length) return;

        const used = {};
        headings.forEach((h, idx) => {
          if (!h.id) {
            let id = slugify(h.textContent) || ('section-' + (idx + 1));
            if (used[id]) id = id + '-' + (idx + 1);
            used[id] = 1;
            h.id = id;
          }
        });

        const tocHtml =
          '<div class="toc" id="tocBox">' +
            '<div class="toc-title">' +
                '<span style="color:var(--accent-primary);">TOC</span>' +
                '<span style="color:var(--text-tertiary); font-weight:900;">목차</span>' +
            '</div>' +
            '<div class="toc-list" id="tocList">' +
              headings.map((h, i) => {
                const lvl = (h.tagName.toLowerCase() === 'h3') ? '3' : '2';
                const pad = (lvl === '3') ? 'padding-left:18px;' : '';
                return (
                  '<a class="toc-item" href="#' + escapeHtml(h.id) + '" data-toc-id="' + escapeHtml(h.id) + '" style="' + pad + '">' +
                    '<span class="toc-text">' + escapeHtml(h.textContent) + '</span>' +
                  '</a>'
                );
              }).join('') +
            '</div>' +
          '</div>';

        const header = root.querySelector('.post-header');
        if (header) header.insertAdjacentHTML('beforeend', tocHtml);

        const tocItems = Array.from(document.querySelectorAll('.toc-item'));
        const byId = {};
        tocItems.forEach(a => { byId[a.getAttribute('data-toc-id')] = a; });

        STATE.tocObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            const id = en.target.id;
