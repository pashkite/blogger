    /* Cards */
    .notice-section { display: grid; gap: 10px; margin-bottom: 24px; }
    .notice-card { background: linear-gradient(90deg, var(--bg-surface), transparent); border-left: 3px solid var(--accent-primary); padding: 12px 16px; border-radius: 4px; display: flex; align-items: center; justify-content: space-between; border: 1px solid var(--border-subtle); border-left-width: 3px; cursor: pointer; transition: transform 0.2s; }
