      }
      function loadProgressMap() {
        const raw = localStorage.getItem(STORAGE_PROGRESS);
        const m = safeJsonParse(raw);
        STATE.progressMap = (m && typeof m === 'object') ? m : {};
      }
      function saveProgressMap() {
        try { localStorage.setItem(STORAGE_PROGRESS, JSON.stringify(STATE.progressMap)); } catch (e) {}
      }

      function loadReaderPrefs() {
        const raw = localStorage.getItem(STORAGE_READER);
        const p = safeJsonParse(raw);
        if (p && typeof p === 'object') {
          const fs = Number(p.fontSize); const w = Number(p.width);
          if (!isNaN(fs)) STATE.readerPrefs.fontSize = clamp(fs, 14, 22);
          if (!isNaN(w)) STATE.readerPrefs.width = (w === 1100 ? 1100 : 900);
        }
      }
      function saveReaderPrefs() {
