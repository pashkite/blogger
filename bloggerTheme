      // ---------- Modal / Lightbox (Focus trap) ----------
      function getFocusable(container) {
        return Array.from(container.querySelectorAll('a[href], button, textarea, input, select, [tabindex]:not([tabindex="-1"])'))
          .filter(el => !el.hasAttribute('disabled') && el.getAttribute('aria-hidden') !== 'true');
      }

      function openOverlay(overlayEl) {
        if (!overlayEl) return;
        STATE.lastFocusEl = document.activeElement;
        overlayEl.classList.add('active');
        overlayEl.setAttribute('aria-hidden', 'false');
        STATE.modalStack.push(overlayEl);
      }

      function closeOverlay(overlayEl) {
        if (!overlayEl) return;
        overlayEl.classList.remove('active');
        overlayEl.setAttribute('aria-hidden', 'true');
        const idx = STATE.modalStack.indexOf(overlayEl);
        if (idx >= 0) STATE.modalStack.splice(idx, 1);
        const restore = STATE.lastFocusEl;
        if (restore && restore.focus) setTimeout(function () { restore.focus(); }, 0);
      }

      function closeTopOverlay() {
        if (!STATE.modalStack.length) return false;
        const top = STATE.modalStack[STATE.modalStack.length - 1];
        closeOverlay(top);
        return true;
      }

      function trapTab(e) {
        if (e.key !== 'Tab') return;
        if (!STATE.modalStack.length) return;
        const overlayEl = STATE.modalStack[STATE.modalStack.length - 1];
        const focusables = getFocusable(overlayEl);
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
      
      // Comments (Blogger API)
      function extractCommentNumericId(value) {
        if (!value) return '';
        const str = String(value);
        let m = str.match(/comment-(\d+)/);
        if (m) return m[1];
        m = str.match(/commentID=(\d+)/);
        if (m) return m[1];
        return '';
      }

      function getCommentNumericId(entry) {
        const rawId = entry && entry.id && entry.id.$t ? entry.id.$t : '';
        const idMatch = extractCommentNumericId(rawId);
        if (idMatch) return idMatch;
        const links = entry && entry.link ? entry.link : [];
        for (let i = 0; i < links.length; i++) {
          const href = links[i] && links[i].href ? String(links[i].href) : '';
          const match = extractCommentNumericId(href);
          if (match) return match;
        }
        return '';
      }

      function getParentCommentId(entry) {
        const reply = entry && entry['thr$in-reply-to'] ? entry['thr$in-reply-to'] : null;
        if (!reply) return '';
        const href = reply.href || (reply.$t ? reply.$t : '');
        const ref = reply.ref || '';
        return extractCommentNumericId(href) || extractCommentNumericId(ref) || '';
      }

      function parseComment(entry) {
        const authorObj = (entry && entry.author && entry.author[0]) ? entry.author[0] : {};
        const rawAuthor = authorObj.name ? authorObj.name.$t : '';
        const authorUri = authorObj.uri && authorObj.uri.$t ? authorObj.uri.$t : '';
        const published = entry && entry.published ? entry.published.$t : '';
        const publishedTs = published ? new Date(published).getTime() : 0;
        const contentHtml = entry && entry.content ? entry.content.$t : (entry && entry.summary ? entry.summary.$t : '');
        const commentId = getCommentNumericId(entry);
        const parentId = getParentCommentId(entry);
        const isAnonymous = !rawAuthor || rawAuthor.toLowerCase() === 'anonymous' || rawAuthor === '익명';
        const anonSeed = authorUri || commentId || rawAuthor || parentId || published;
        const anonIndex = anonSeed ? (hashString(anonSeed) % 99) + 1 : '';
        const author = isAnonymous ? (anonIndex ? ('익명#' + anonIndex) : '익명') : rawAuthor;
        const avatarSeed = authorUri || rawAuthor || commentId || published;
        let avatar = (authorObj['gd$image'] && authorObj['gd$image'].src) ? authorObj['gd$image'].src : '';
        if (isAnonymous) avatar = '';
        const avatarColor = getAvatarColor(avatarSeed || anonSeed);
        const avatarText = getAvatarText(author);
        return {
          commentId,
          parentId,
          author,
          avatar,
          avatarColor,
          avatarText,
          published,
          publishedTs,
          contentHtml: sanitizeCommentHtml(contentHtml),
          isReply: !!parentId,
          isAnonymous
        };
      }

      function normalizeUrl(u) {
        try {
          const url = new URL(u, location.origin);
          url.hash = '';
          url.searchParams.delete('m');
          const search = url.searchParams.toString();
          return url.origin + url.pathname.replace(/\/$/, '') + (search ? '?' + search : '');
        } catch (e) {
          return String(u || '').replace(/#.*$/, '').replace(/([?&])m=\d+(&|$)/, '$1').replace(/[?&]$/, '').replace(/\/$/, '');
        }
      }

      function getInlineCommentSrc(postId) {
        const nodes = Array.from(document.querySelectorAll('.comment-form-src'));
        if (!nodes.length) return '';
        for (let i = 0; i < nodes.length; i++) {
          const el = nodes[i];
          const elPostId = el.getAttribute('data-post-id') || '';
          if (postId && elPostId && String(elPostId) !== String(postId)) continue;
          return el.getAttribute('data-comment-src') || '';
        }
        return nodes[0].getAttribute('data-comment-src') || '';
      }

      function addUrlParam(url, key, value) {
        try {
          const u = new URL(url, location.origin);
          u.searchParams.set(key, value);
          return u.href;
        } catch (e) {
          const sep = url.indexOf('?') === -1 ? '?' : '&';
          return url + sep + encodeURIComponent(key) + '=' + encodeURIComponent(value);
        }
      }

      async function fetchCommentFormSrcFromUrl(url, postId) {
        if (!url) return '';
        try {
          const resolved = new URL(url, location.origin);
          const fetchUrl = (resolved.origin === location.origin) ? resolved.href : (resolved.pathname + resolved.search);
          const res = await fetch(fetchUrl, { credentials: 'same-origin' });
          if (!res.ok) return '';
          const html = await res.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const nodes = Array.from(doc.querySelectorAll('.comment-form-src'));
          if (!nodes.length) return '';
          for (let i = 0; i < nodes.length; i++) {
            const el = nodes[i];
            const elPostId = el.getAttribute('data-post-id') || '';
            if (postId && elPostId && String(elPostId) !== String(postId)) continue;
            return el.getAttribute('data-comment-src') || '';
          }
          return nodes[0].getAttribute('data-comment-src') || '';
        } catch (e) {
          return '';
        }
      }

      async function getCommentFormSrc(post) {
        const postId = post && post.postId ? post.postId : post;
        if (post && post.commentFormSrc) return post.commentFormSrc;
        let src = getInlineCommentSrc(postId);
        if (!src && post && post.url) src = await fetchCommentFormSrcFromUrl(post.url, postId);
        if (post && src) post.commentFormSrc = src;
        return src || '';
      }

      function renderComments(comments) {
        const list = document.getElementById('commentsList');
        const countEl = document.getElementById('commentCount');
        if (!list) return;
